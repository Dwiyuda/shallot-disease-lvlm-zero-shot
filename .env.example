# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK di-commit.
# API key OpenRouter — ambil di https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Model (opsional). Kosongkan untuk pakai default: google/gemini-3.1-flash-lite
# — model terbaik dari perbandingan (82,5% split test).
# Hasil tiap model otomatis masuk results/<nama-model>/ terpisah.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
